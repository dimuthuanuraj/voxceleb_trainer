    "optimizer": "adam",
    "scheduler": "steplr",
    "lr": 0.001,
    "lr_decay": 0.95,
    "weight_decay": 2e-5,
    "max_epoch": 60,
    # EER on the validation trials after EVERY epoch (was 2).

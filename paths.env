# ---------------------------------------------------------------------
# Path configuration for voxceleb_trainer / SL_ColvaiAI
# ---------------------------------------------------------------------
# Copy this file to `paths.env` (or set the variables in your shell
# profile / job submission script) and edit the right-hand side to
# match the local layout. The configs under `configs/` reference these
# variables as ${SL_SPV_DATA_ROOT} / ${SL_SPV_VOX_FULL_ROOT} /
# ${SL_SPV_AUGMENT_ROOT}; the trainers' YAML loader expands them at
# startup (see BUGFIX-013).
#
# Usage:
#   source paths.env
#   python trainSpeakerNet.py --config configs/<your-config>.yaml
#
# Unresolved variables fail the training run with a clear error,
# rather than silently passing through "${SL_SPV_DATA_ROOT}" as a
# literal path. Any specific path can still be overridden on the CLI
# (e.g. --train_path /tmp/quick-test) without setting the variable.
# ---------------------------------------------------------------------

# Primary corpus root. Most configs assume train_list / test_list /
# train_path / test_path / musan_path / rir_path all live under this
# directory. On the original development machine this was:
#     /mnt/ricproject3/2025/data
export SL_SPV_DATA_ROOT=/mnt/ricproject3/2025/data

# Full-VoxCeleb corpus root. Used only by the mlp_mixer_rawwaveform_*
# configs which train on the full VoxCeleb2 rather than the mini
# subset. On the original development machine this was:
#     /mnt/ricproject2/voxceleb_new
# Leave unset if you do not run the full-VoxCeleb configs.
export SL_SPV_VOX_FULL_ROOT=/mnt/ricproject2/voxceleb_new

# Augmentation corpus root (MUSAN + RIRs) when these live on a
# *different* mount than the main corpus — that is, when musan_path
# and rir_path are not under SL_SPV_DATA_ROOT. Only the
# mlp_mixer_rawwaveform_* configs need this variable in the current
# tree. On the original development machine this was:
#     /mnt/ricproject/data
# Leave unset if MUSAN and RIRs live under SL_SPV_DATA_ROOT.
export SL_SPV_AUGMENT_ROOT=/mnt/ricproject/data
